<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Order Confirmation - Legacy Bridge Publishing</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f8; font-family:'Helvetica Neue', Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0f4f8; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#f7f8fa; padding:28px 40px 24px; border-radius:12px 12px 0 0; border:1px solid #e2e8f0; border-bottom:none;">
              <img
                src="https://res.cloudinary.com/dze1xnnxx/image/upload/v1776426280/IntelliBridge_Blue_App_Icon_nnmxvu.png"
                alt="Legacy Bridge Publishing"
                width="60"
                height="60"
                style="display:block; margin:0 auto 14px; border-radius:14px;"
              />
              <p style="margin:0; font-size:20px; font-weight:700; color:#1a1a1a;">Order Confirmed!</p>
              <p style="margin:6px 0 0; font-size:12px; color:#888888; letter-spacing:1px; text-transform:uppercase;">Purchase Successful</p>
              <p style="margin:10px 0 0; font-size:14px; color:#555555;">Thank you for your purchase, <strong style="color:#1a1a1a;">{{name}}</strong>.</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff; padding:28px 40px 0; border-left:1px solid #e2e8f0; border-right:1px solid #e2e8f0;">

              <!-- Success badge -->
              <table cellpadding="0" cellspacing="0" border="0" style="margin-bottom:24px;">
                <tr>
                  <td style="border:1px solid #86efac; border-radius:50px; padding:8px 20px; background-color:#f0fdf4;">
                    <span style="font-size:13px; font-weight:600; color:#166534;">&#10003;&nbsp; Payment Successful</span>
                  </td>
                </tr>
              </table>

              <!-- Order Meta -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="border:1px solid #e2e8f0; border-radius:10px; margin-bottom:28px;">
                <tr>
                  <td style="padding:14px 18px; border-bottom:1px solid #e2e8f0;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-size:13px; color:#888888;">Order Reference</td>
                        <td align="right" style="font-size:13px; font-weight:600; color:#1a1a1a; font-family:'Courier New', Courier, monospace;">{{transactionReference}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding:14px 18px; border-bottom:1px solid #e2e8f0;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-size:13px; color:#888888;">Order Date</td>
                        <td align="right" style="font-size:13px; font-weight:600; color:#1a1a1a;">{{paidAt}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
                <tr>
                  <td style="padding:14px 18px;">
                    <table width="100%" cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td style="font-size:13px; color:#888888;">Customer</td>
                        <td align="right" style="font-size:13px; font-weight:600; color:#1a1a1a;">{{email}}</td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Order Summary Heading -->
              <p style="margin:0 0 14px; font-size:15px; font-weight:700; color:#1a1a1a; border-bottom:1px solid #e2e8f0; padding-bottom:12px;">Order Summary</p>

              <!-- Order Items Table -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
                <!-- Table Header -->
                <tr style="background-color:#f7f8fa;">
                  <td style="padding:10px 10px; font-size:11px; font-weight:700; color:#888888; text-transform:uppercase; letter-spacing:0.8px; border-bottom:1px solid #e2e8f0;">Book</td>
                  <td style="padding:10px 10px; font-size:11px; font-weight:700; color:#888888; text-transform:uppercase; letter-spacing:0.8px; border-bottom:1px solid #e2e8f0;">Author</td>
                  <td style="padding:10px 10px; font-size:11px; font-weight:700; color:#888888; text-transform:uppercase; letter-spacing:0.8px; border-bottom:1px solid #e2e8f0;">Format</td>
                  <td align="right" style="padding:10px 10px; font-size:11px; font-weight:700; color:#888888; text-transform:uppercase; letter-spacing:0.8px; border-bottom:1px solid #e2e8f0;">Price</td>
                </tr>

                <!-- Dynamic Items -->
                {{#each items}}
                <tr>
                  <td style="padding:13px 10px; font-size:13px; font-weight:600; color:#1a1a1a; border-bottom:1px solid #f0f4f8; vertical-align:top;">{{this.title}}</td>
                  <td style="padding:13px 10px; font-size:13px; color:#555555; border-bottom:1px solid #f0f4f8; vertical-align:top;">{{this.author}}</td>
                  <td style="padding:13px 10px; font-size:12px; color:#888888; border-bottom:1px solid #f0f4f8; vertical-align:top;">{{this.bookFormat}}</td>
                  <td align="right" style="padding:13px 10px; font-size:13px; font-weight:600; color:#1a1a1a; border-bottom:1px solid #f0f4f8; vertical-align:top; white-space:nowrap;">{{this.currency}} {{this.price}}</td>
                </tr>
                {{/each}}

                <!-- Total Row -->
                <tr>
                  <td colspan="3" style="padding:14px 10px; font-size:14px; font-weight:700; color:#1a1a1a; border-top:2px solid #1a1a1a;">Total</td>
                  <td align="right" style="padding:14px 10px; font-size:16px; font-weight:700; color:#1a1a1a; border-top:2px solid #1a1a1a; white-space:nowrap;">{{currency}} {{totalAmount}}</td>
                </tr>
              </table>

              <!-- Access Info -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="margin-bottom:28px;">
                <tr>
                  <td style="border-left:3px solid #3b82f6; padding:14px 16px; background-color:#eff6ff;">
                    <p style="margin:0 0 5px; font-size:13px; font-weight:700; color:#1e40af;">Your books are ready!</p>
                    <p style="margin:0; font-size:13px; color:#555555; line-height:1.6;">
                      Log in to your account and visit <strong>My Library</strong> to access all your purchased books. Your books will be available immediately.
                    </p>
                  </td>
                </tr>
              </table>

              <!-- Support Note -->
              <p style="margin:0 0 32px; font-size:13px; color:#888888; line-height:1.7; text-align:center;">
                If you have any questions about your order, please reply to this email or reach out to our support team.<br>
                Keep this email as your receipt for reference <strong style="color:#555555;">{{transactionReference}}</strong>.
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f7f8fa; padding:18px 40px; border-radius:0 0 12px 12px; border:1px solid #e2e8f0; border-top:none;">
              <p style="margin:0 0 3px; font-size:13px; font-weight:600; color:#1a1a1a;">Legacy Bridge Publishing</p>
              <p style="margin:0; font-size:11px; color:#888888; letter-spacing:0.5px;">Preserving stories. Bridging generations.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>