<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <!-- Prevent iOS Mail dark mode from auto-inverting colors -->
  <meta name="color-scheme" content="light only">
  <meta name="supported-color-schemes" content="light">
  <title>Password Reset OTP - Legacy Bridge Publishing</title>
  <style>
    /* Force light-mode rendering on Apple Mail / iOS */
    :root { color-scheme: light only; }

    /* Critical color overrides with !important — inline styles cannot use !important
       but <style> block rules beat Apple Mail's dark-mode UA overrides */
    .header-title   { color: #ffffff !important; }
    .header-sub     { color: #B4975A !important; }
    .otp-label      { color: #B4975A !important; }
    .otp-code       { color: #ffffff !important; }
    .footer-name    { color: #ffffff !important; }
    .footer-tagline { color: #B4975A !important; }
  </style>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f8; font-family: 'Helvetica Neue', Arial, sans-serif; color:#333;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0f4f8; padding: 40px 0;">
    <tr>
      <td align="center">
        <table width="620" cellpadding="0" cellspacing="0" border="0" style="max-width:620px; width:100%;">

          <!-- Header with Logo -->
          <tr>
            <td align="center" style="background: linear-gradient(160deg, #001534 0%, #01224f 60%, #012d6b 100%); padding: 36px 40px 28px; border-radius: 12px 12px 0 0;">
              <img
                src="https://res.cloudinary.com/dze1xnnxx/image/upload/v1776426280/IntelliBridge_Blue_App_Icon_nnmxvu.png"
                alt="Legacy Bridge Publishing"
                width="72"
                height="72"
                style="display:block; margin: 0 auto 16px; border-radius: 16px;"
              />
              <h1 class="header-title" style="margin:0; font-size:22px; font-weight:700; color:#ffffff; letter-spacing:0.3px;">Password Reset Request</h1>
              <p class="header-sub" style="margin:8px 0 0; font-size:14px; color:#B4975A; letter-spacing:1.5px; text-transform:uppercase; font-weight:600;">Security Verification</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff; padding: 36px 40px 28px;">
              <p style="margin:0 0 16px; font-size:15px; color:#2d3748; line-height:1.7;">Hi <strong>{{name}}</strong>,</p>
              <p style="margin:0 0 16px; font-size:14px; color:#4a5568; line-height:1.7;">
                We received a request to reset the password for the account associated with <strong>{{email}}</strong>.
                Use the one-time code below to proceed. Do not share this code with anyone.
              </p>

              <!-- OTP Block -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="padding: 28px 0;">
                    <div style="display:inline-block; background: linear-gradient(160deg, #001534 0%, #012d6b 100%); border-radius: 12px; padding: 24px 48px;">
                      <p class="otp-label" style="margin:0 0 6px; font-size:11px; color:#B4975A; letter-spacing:2px; text-transform:uppercase; font-weight:700;">Your OTP Code</p>
                      <p class="otp-code" style="margin:0; font-size:38px; font-weight:800; color:#ffffff; letter-spacing:10px; font-family: 'Courier New', monospace;">{{resetCode}}</p>
                    </div>
                  </td>
                </tr>
              </table>

              <!-- Expiry notice -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fff8f0; border-radius:8px; border-left: 4px solid #B4975A;">
                <tr>
                  <td style="padding: 14px 18px;">
                    <p style="margin:0; font-size:13px; color:#744210; line-height:1.6;">
                      &#8987;&nbsp; This OTP is valid for <strong>6 hours</strong>. If you didn't request a password reset, you can safely ignore this email — your password will not change.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="margin: 28px 0 0; font-size:14px; color:#4a5568; line-height:1.7;">
                Best regards,<br>
                <strong style="color:#001534;">The Legacy Bridge Publishing Team</strong>
              </p>
            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#001534; padding: 20px 40px; border-radius: 0 0 12px 12px;">
              <p class="footer-name" style="margin:0 0 4px; font-size:13px; font-weight:700; color:#ffffff;">Legacy Bridge Publishing</p>
              <p class="footer-tagline" style="margin:0; font-size:11px; color:#B4975A; letter-spacing:1px;">Preserving stories. Bridging generations.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>
