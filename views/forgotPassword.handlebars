<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light">
  <meta name="supported-color-schemes" content="light">
  <title>Password Reset - Legacy Bridge Publishing</title>
</head>
<body style="margin:0; padding:0; background-color:#f0f4f8; font-family:'Helvetica Neue', Arial, sans-serif;">

  <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f0f4f8; padding:40px 0;">
    <tr>
      <td align="center">
        <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%;">

          <!-- Header -->
          <tr>
            <td align="center" style="background-color:#f7f8fa; padding:28px 40px 24px; border-radius:12px 12px 0 0; border:1px solid #e2e8f0; border-bottom:none;">
              <img
                src="https://res.cloudinary.com/dze1xnnxx/image/upload/v1776426280/IntelliBridge_Blue_App_Icon_nnmxvu.png"
                alt="Legacy Bridge Publishing"
                width="60"
                height="60"
                style="display:block; margin:0 auto 14px; border-radius:14px;"
              />
              <p style="margin:0; font-size:18px; font-weight:700; color:#1a1a1a;">Password Reset Request</p>
              <p style="margin:6px 0 0; font-size:12px; color:#888888; letter-spacing:1px; text-transform:uppercase;">Security Verification</p>
            </td>
          </tr>

          <!-- Body -->
          <tr>
            <td style="background-color:#ffffff; padding:32px 40px; border-left:1px solid #e2e8f0; border-right:1px solid #e2e8f0;">

              <p style="margin:0 0 14px; font-size:15px; color:#1a1a1a;">Hi <strong>{{name}}</strong>,</p>
              <p style="margin:0 0 28px; font-size:14px; color:#555555; line-height:1.7;">
                We received a request to reset the password for <strong style="color:#1a1a1a;">{{email}}</strong>.
                Use the one-time code below to proceed. Do not share this code with anyone.
              </p>

              <!-- OTP Block -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td align="center" style="padding:0 0 28px;">
                    <table cellpadding="0" cellspacing="0" border="0">
                      <tr>
                        <td align="center" style="border:1px solid #cccccc; border-radius:10px; padding:20px 48px; background-color:#fafafa;">
                          <p style="margin:0 0 8px; font-size:11px; color:#888888; letter-spacing:1.5px; text-transform:uppercase;">Your one-time code</p>
                          <p style="margin:0; font-size:36px; font-weight:700; color:#1a1a1a; letter-spacing:10px; font-family:'Courier New', Courier, monospace;">{{resetCode}}</p>
                        </td>
                      </tr>
                    </table>
                  </td>
                </tr>
              </table>

              <!-- Expiry notice -->
              <table width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <td style="border-left:3px solid #d97706; padding:12px 16px; background-color:#fffbeb;">
                    <p style="margin:0; font-size:13px; color:#92400e; line-height:1.6;">
                      This code expires in <strong>6 hours</strong>. If you didn't request a password reset, you can safely ignore this email — your password will not change.
                    </p>
                  </td>
                </tr>
              </table>

              <p style="margin:28px 0 0; font-size:14px; color:#555555; line-height:1.7;">
                Best regards,<br>
                <strong style="color:#1a1a1a;">The Legacy Bridge Publishing Team</strong>
              </p>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td align="center" style="background-color:#f7f8fa; padding:18px 40px; border-radius:0 0 12px 12px; border:1px solid #e2e8f0; border-top:none;">
              <p style="margin:0 0 3px; font-size:13px; font-weight:600; color:#1a1a1a;">Legacy Bridge Publishing</p>
              <p style="margin:0; font-size:11px; color:#888888; letter-spacing:0.5px;">Preserving stories. Bridging generations.</p>
            </td>
          </tr>

        </table>
      </td>
    </tr>
  </table>

</body>
</html>