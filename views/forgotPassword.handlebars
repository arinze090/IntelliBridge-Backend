<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Password Reset OTP</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      line-height: 1.6;
      color: #333;
    }
    .container {
      max-width: 600px;
      margin: 0 auto;
      padding: 20px;
      border: 1px solid #ddd;
      border-radius: 5px;
    }
    .otp-code {
      font-size: 32px;
      font-weight: bold;
      color: #0056b3;
      text-align: center;
      letter-spacing: 5px;
      margin: 20px 0;
    }
  </style>
</head>
<body>
  <div class="container">
    <h2>Password Reset Request</h2>
    <p>Hi {{name}},</p>
    <p>We received a request to reset the password for your account associated with {{email}}.</p>
    <p>Please use the following 6-digit OTP code to reset your password.</p>
    
    <div class="otp-code">
      {{resetCode}}
    </div>
    
    <p>This OTP is valid for 2 hours. If you did not request a password reset, please ignore this email.</p>
    
    <p style="margin-top: 30px;">Best regards,<br>The Legacy Bridge Publishing Team</p>
  </div>
</body>
</html>
